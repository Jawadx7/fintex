// Prisma 7 generates TypeScript sources into ./generated/prisma.
// This directory is gitignored; run `npm run db:generate` after cloning.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth.js v5 uses JWT sessions, so no Session/VerificationToken tables are
// needed. Users here are app accounts (staff or customers), not OAuth accounts.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(USER)
  address      String?
  country      String?
  postalCode   String?
  birthDate    DateTime?
  idNumber     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  riskReviews RiskAssessment[] @relation("Reviewer")
}

// Wallet-based transaction scored by the compliance engine. This is the output
// contract the future scoring pipeline writes; see lib/compliance/schemas.ts.
model Transaction {
  id                  String          @id @default(cuid())
  idempotencyKey      String          @unique
  type                TransactionType
  amount              Decimal         @db.Decimal(14, 2)
  currency            String          @default("GHS")
  senderWallet        String
  receiverWallet      String
  senderBalanceBefore Decimal?        @db.Decimal(14, 2)
  occurredAt          DateTime
  createdAt           DateTime        @default(now())

  assessment RiskAssessment?

  // The rules engine looks up wallet history by time window.
  @@index([senderWallet, occurredAt])
  @@index([receiverWallet, occurredAt])
}

// One-to-one scoring result for a Transaction.
model RiskAssessment {
  id            String       @id @default(cuid())
  transactionId String       @unique
  riskScore     Float
  tier          RiskTier
  action        RiskAction
  tags          String[]
  reasons       String[]
  evidence      Json?
  modelVersion  String
  latencyMs     Int?
  createdAt     DateTime     @default(now())

  // Review workflow. A null reviewStatus means no review is required.
  reviewStatus ReviewStatus?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tier, createdAt])
  @@index([reviewStatus])
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  TRANSFER
  CASH_OUT
}

enum RiskTier {
  LOW
  MEDIUM
  HIGH
}

enum RiskAction {
  ALLOW
  ALLOW_AND_REVIEW
  HOLD_AND_ALERT
}

enum ReviewStatus {
  OPEN
  ESCALATED
  DISMISSED
  CONFIRMED
}
