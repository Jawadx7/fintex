# Postgres connection string.
# Neon: use the POOLED url (-pooler host, port 5432/6543) for the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/fintex?sslmode=require"

# Optional: the direct (non-pooled) Neon url, used by `prisma migrate` and
# `npm run db:seed`, which need a connection that can run DDL.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/fintex?sslmode=require"

# IMPORTANT: do NOT add `channel_binding=require` to either url.
# Prisma's CLI fails with P1001 ("Can't reach database server") when that
# parameter is present, so `prisma migrate`/`db:seed` will break.
# Also note pg's driver currently treats sslmode=require as verify-full, which
# rejects TLS interception by corporate proxies -- if connections fail with
# "Connection terminated unexpectedly", that is the cause, not your code.

# Secret used to sign/verify session JWTs. Generate with:
#   npx auth secret
# or: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Seed credentials `npm run db:seed` upserts these two accounts and
# is safe to re-run. Defaults shown below if unset.
SEED_ADMIN_EMAIL="admin@fintex.app"
SEED_ADMIN_PASSWORD="fintex-admin-2026"
SEED_DEMO_EMAIL="demo@fintex.app"
SEED_DEMO_PASSWORD="fintex-demo-2026"

# Demo login helper. When NEXT_PUBLIC_SHOW_DEMO_LOGIN is not "true"
# the credentials below are never shipped to the browser and the login page
# shows no demo panel. Only enable this on demo/staging environments.
NEXT_PUBLIC_SHOW_DEMO_LOGIN="false"
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="admin@fintex.app"
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="fintex-admin-2026"
